# Version control
.git
.gitignore
.gitmodules

# Dependencies (installed fresh in container)
node_modules

# Build artifacts (generated during docker build)
dist/
prod/
icons/build

# Environment and secrets
.env
.env.*
.env.local
.env.*.local
*.pem
*.key

# NPM/Yarn config (may contain registry tokens)
.npmrc
.yarnrc
.yarnrc.yml

# IDE and editor
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test and coverage
coverage/
.nyc_output/
htmlcov/
.tox/
.nox/
.pytest_cache/
__pycache__/

# CI/CD (not needed for build)
.github/

# Cache
.cache
*.tsbuildinfo
.eslintcache

# Generated assets (build creates these)
static/assets/img/genmapthumbs/*
static/assets/forms/autogen/*

# OS metadata
.DS_Store
Thumbs.db

# Docker (may contain local secrets or dev config)
docker-compose*.yml
docker-compose*.yaml
Dockerfile*
.dockerignore

# Local config overrides (may contain wmsBasicAuth credentials)
themesConfig.local.json
themesConfig.*.local.json
static/themesConfig.local.json
static/themesConfig.*.local.json

# Documentation (not needed for build)
docs/
*.md
